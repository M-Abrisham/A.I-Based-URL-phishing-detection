# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# VirusTotal — https://www.virustotal.com/gui/my-apikey (free tier: 500 req/day)
VT_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/account/api (free tier: 1000 req/day)
ABUSEIPDB_API_KEY=

# AlienVault OTX — https://otx.alienvault.com/api (free, register for a key)
OTX_API_KEY=

# Cache location for enrichment results
EMLSCOPE_CACHE_DIR=.emlscope-cache
